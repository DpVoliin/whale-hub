# 复制成 .env 再填。**这个文件本身不含任何真实密钥，可以进仓库。**
# 真值放 .env（已在 .gitignore 里）或系统环境变量。

# ---- 说话层（whale_speaker.py）----
WHALE_HUB=https://YOUR_SERVER:11443     # 中枢地址
WHALE_TOKEN=                            # 中枢 token（从一键部署的输出里抄）
WHALE_CA=/opt/whale/hub/tls/hub.crt     # 自签证书路径（客户端要做证书固定）
# 措辞用的模型（OpenAI 兼容接口）
LLM_BASE=https://api.example.com/v1
LLM_KEY=
LLM_MODEL=

# ---- 中枢（hub.py）----
HUB_PORT=11440
HUB_TLS_PORT=11443
HUB_TLS_CERT=/opt/whale/hub/tls/hub.crt
HUB_TLS_KEY=/opt/whale/hub/tls/hub.key

# ---- 开发用（只在本机/CI 用，**运行时不需要**）----
# pytest / hypothesis / ruff 都属于开发依赖，不进运行时
