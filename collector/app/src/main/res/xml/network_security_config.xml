<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 全局禁止明文 HTTP：所有上报必须走 TLS -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- 只信任「鲸鲸中枢」这一张证书（证书固定）：
         换了证书、或者有人中间人冒充网关，App 会直接拒连，不会把数据交出去 -->
    <domain-config>
        <domain includeSubdomains="false">YOUR_SERVER_IP</domain>
        <trust-anchors>
            <certificates src="@raw/hub_cert" />
        </trust-anchors>
    </domain-config>
</network-security-config>
